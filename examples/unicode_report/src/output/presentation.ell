defmodule Output.Presentation do
  def banner() -> string do
    buffer = Buffer.new()
    titled = Buffer.append_string(buffer, "EL v1")
    separated = Buffer.append_bytes(titled, String.bytes(" · "))
    complete = Buffer.append_string(separated, "Unicode report")
    match Buffer.to_string(complete) do
      {:ok, text} -> text
      {:error, _} -> "Unicode report"
    end
  end

  def print_frequency(entry: {string, i32}) -> unit do
    match entry do
      {grapheme, count} ->
        IO.println("  #{grapheme}: #{count}")
    end
  end

  def print(summary: Analysis.TextStats.Summary) -> unit do
    IO.println(banner())
    IO.println("Input: #{summary.text}")
    IO.println("UTF-8 bytes: #{summary.byte_count}")
    IO.println("Unicode code points: #{summary.codepoint_count}")
    IO.println("Extended grapheme clusters: #{summary.grapheme_count}")
    IO.println("Unique grapheme clusters: #{summary.unique_graphemes}")
    IO.println("Space-delimited words: #{summary.word_count}")
    IO.println("Contains 🙂: #{summary.contains_smile}")
    IO.println("Frequency map (first-seen order):")
    Enum.each(summary.frequencies, print_frequency)
  end
end
