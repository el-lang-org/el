# conformance: accept; spec=docs/DESIGN.md §7, docs/EXAMPLES.md §13
defmodule Main do
  def main() -> i32 do
    fields = String.split("a,,é,", ",")
    words = "abc def" |> String.split()
    if String.empty("") and
      String.empty("a") == false and
      String.contains("café", "fé") and
      String.contains("abc", "") and
      fields == ["a", "", "é", ""] and
      String.split("abc", "") == ["abc"] and
      String.split("abc def") == ["abc", "def"] and
      words == ["abc", "def"] do
      0
    else
      1
    end
  end
end
